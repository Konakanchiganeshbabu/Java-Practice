package com.basic;

public class TwoSum {
	public static void main(String[] args) {
		int[] arr1 = {2, 7, 11, 15};
		System.out.println(checkTwoSum(arr1, 9));
		
		int[] arr2 = {3, 2, 4};
		System.out.println(checkTwoSum(arr2, 6));
		
		int[] arr3 = {1, 2, 3, 4, 5};
		System.out.println(checkTwoSum(arr3, 99));
	}
	
	public static boolean checkTwoSum(int[] arr, int target) {
		for(int i=0; i<arr.length-1; i++) {
			for(int j=i+1; j<arr.length; j++) {
				if(arr[i] + arr[j] == target) {
					return true;
				}
			}
		}
		return false;
	}
}
