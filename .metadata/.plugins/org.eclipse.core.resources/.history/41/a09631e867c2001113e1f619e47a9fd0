package com;

public class TwoSum {
	public static void main(String[] args) {
		int[] arr = {2, 1, 4, 9, 6, 5, 7, 3};
		int target = 14;
		
		System.out.println(checkTwoSum(arr, target));
	}
	
	static boolean checkTwoSum(int[] arr, int target) {
		int n = arr.length;
		
		for(int i=0; i<n-1; i++) {
			for(int j=i+1; j<n; j++) {
				if(arr[i] + arr[j] == target) {
					return true;
				}
			}
		}
		return false;
		
	}
}
