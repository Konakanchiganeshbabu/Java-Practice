package com.basic;

import java.util.Arrays;

public class TwoSum {
	public static void main(String[] args) {
		int[] arr1 = {2, 7, 11, 15};
		System.out.println(checkTwoSum(arr1, 9));
		
		int[] arr2 = {3, 2, 4};
		System.out.println(checkTwoSum(arr2, 6));
		
		int[] arr3 = {1, 2, 3, 4, 5};
		System.out.println(checkTwoSum(arr3, 99));
		
		System.out.println("=========================");
		System.out.println(checkTwoSum2(arr1, 9));

		System.out.println(checkTwoSum2(arr2, 6));

		System.out.println(checkTwoSum2(arr3, 99));
	}
	
	public static boolean checkTwoSum(int[] arr, int target) {
		for(int i=0; i<arr.length-1; i++) {
			for(int j=i+1; j<arr.length; j++) {
				if(arr[i] + arr[j] == target) {
					return true;
				}
			}
		}
		return false;
	}
	
	public static boolean checkTwoSum2(int[] arr, int target) {
		Arrays.sort(arr);
		int start = 0;
		int end = arr.length -1;
		while(start < end) {
			int sum = arr[start] + arr[end];
			if(sum == target) {
				return true;
			}else if(sum < target) {
				start += 1;
			}else if(sum > target) {
				end -= 1;
			}
		}
		
		return false;
	}
}
