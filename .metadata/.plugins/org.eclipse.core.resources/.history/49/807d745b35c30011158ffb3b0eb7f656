package com;

public class ThreeSum {
	public static void main(String[] args) {
		int[] arr = {2, 1, 4, 9, 6, 5, 7, 3, 68};
		int target = 14;
		
		System.out.println(checkThreeSum(arr, target));
	}
	
	
	//brute force approach
	static boolean checkThreeSum(int[] arr, int target) {
		int n = arr.length;
		for(int i=0; i<n-2; i++) {
			for(int j=i+1; j<n-1; j++) {
				for(int k=j+1; k<n; k++) {
					if(arr[i] + arr[j] + arr[k] == target) {
						return true;
					}
				}
			}
		}
		return false;
	}
}
